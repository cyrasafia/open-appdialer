<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知唤起（spec F9）：唯一运行时权限（33+），拒绝时静默降级 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- dock 直达 overlay（spec F10）：特殊权限，设置页授权一次 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 无 INTERNET 权限（永不申请）。可见性通过 <queries> 声明，
         比 QUERY_ALL_PACKAGES 更精准且无需 Play 特殊审核：
         仅可见带 MAIN/LAUNCHER intent-filter 的应用（即 F1 数据源） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".OpenAppDialerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.OpenAppDialer">

        <!-- dock/桌面图标：NoDisplay 跳板（spec F10）。v3.8：
             挂 NullWindowAnimations 消除 task-open 转场的白色放大缩小动画；
             excludeFromRecents + noHistory 防止最近任务残留白色全屏卡片 -->
        <activity
            android:name=".panel.PanelLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OpenAppDialer.Trampoline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- 常驻面板服务（spec F10） -->
        <service
            android:name=".panel.PanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating-app-launcher-panel" />
        </service>
    </application>
</manifest>
