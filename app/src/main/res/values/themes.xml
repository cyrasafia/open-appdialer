<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      浮窗主题（spec F8）：
      - windowIsTranslucent：Android 12+ 跳过系统 SplashScreen（黑底闪烁根因），旧版本跳过 starting window
      - windowIsFloating + 透明背景：不占满全屏
      - 点外部关闭（windowCloseOnTouchOutside）+ 背后遮罩
      - 明暗色由 Compose 主题接管，框架层无需 Light/night 变体
    -->
    <style name="Theme.OpenAppDialer" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <!-- 无遮罩（spec v2.3）：MIUI 应用打开动画的边缘缩放会与遮罩叠加穿帮，且遮罩曾是黑底来源 -->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- 清空启动/关闭动画（spec v2.5）：MIUI 的 taskOpen 缩放动画会让桌面变暗约 1s，
             小米官方文档建议的禁用方式即覆盖 windowAnimationStyle -->
        <item name="android:windowAnimationStyle">@style/NullWindowAnimations</item>
    </style>

    <!-- 跳板主题：NoDisplay + 动画置空（v3.8），消除 task-open 转场白屏动画 -->
    <style name="Theme.OpenAppDialer.Trampoline">
        <item name="android:windowAnimationStyle">@style/NullWindowAnimations</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NullWindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:taskOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/no_anim</item>
        <item name="android:activityOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperOpenExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperCloseExitAnimation">@anim/no_anim</item>
    </style>
</resources>
